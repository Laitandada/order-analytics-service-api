# Database connection URL example for PostgreSQL 
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?schema=public"
SEED_MODE="dev"

# Primary database (accepts writes + order ID lookups requiring read-after-write consistency)
PRIMARY_DATABASE_URL="postgresql://<db_user>:<db_password>@<primary_host>:<db_port>/<db_name>?schema=public"

# Read replica (analytics and paginated reads - eventual consistency acceptable)
# In production: URL of a PostgreSQL hot-standby replica.
# In local development: may point to the same instance as PRIMARY_DATABASE_URL.
READ_DATABASE_URL="postgresql://<db_user>:<db_password>@<replica_host>:<db_port>/<db_name>?schema=public"

# PostgreSQL connection pool configuration parameters
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=2000
